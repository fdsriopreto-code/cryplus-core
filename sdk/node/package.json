{
  "name": "cryplus",
  "version": "0.2.0",
  "description": "Cryplus SDK: field-level, per-record envelope encryption via cryplus-core, with a Prisma extension.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdsriopreto-code/cryplus-core.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/fdsriopreto-code/cryplus-core#readme"
}
