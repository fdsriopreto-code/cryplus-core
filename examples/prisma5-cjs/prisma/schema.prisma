generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform-level table: its secrets are encrypted under the fixed "__platform__" tenant,
// because the tenant row is created/read before any tenant context exists (signup, login).
model Tenant {
  id                  String        @id @default(uuid())
  nome                String
  /// @encrypted
  mpOauthAccessToken  String?
  /// @encrypted
  mpOauthRefreshToken String?
  funcionarios        Funcionario[]
  configuracoes       Configuracao[]
  conversas           Conversa[]
  clientes            Cliente[]
}

model Funcionario {
  id          String  @id @default(uuid())
  tenantId    String
  nome        String
  /// @encrypted(searchable, digits)
  cpf         String?
  cpfIdx      String?
  /// @encrypted
  rg          String?
  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  // uniqueness must live on the blind index, not on the ciphertext
  @@unique([tenantId, cpfIdx])
}

// Generic key/value table. Sensitive values go in valorSecreto, so non-sensitive keys
// (and phone lookups done in raw SQL) keep using `valor`.
model Configuracao {
  id            String @id @default(uuid())
  tenantId      String
  chave         String
  valor         String?
  /// @encrypted
  valorSecreto  String?
  tenant        Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, chave])
}

model Conversa {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  mensagens Mensagem[]
}

// No tenantId column: the tenant comes from the request context, not from the row.
model Mensagem {
  id         String   @id @default(uuid())
  conversaId String
  direcao    String
  /// @encrypted
  conteudo   String?
  linkHash   String?
  createdAt  DateTime @default(now())
  conversa   Conversa @relation(fields: [conversaId], references: [id])

  @@index([conversaId, linkHash])
}

// Real database names via @map/@@map, searchable by suffix and globally, String[] and Json.
model Cliente {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  nome         String
  /// @encrypted(searchable, digits)
  cpfCnpj      String?     @map("cpf_cnpj")
  cpfCnpjIdx   String?     @map("cpf_cnpj_idx")
  /// @encrypted(suffix(4), suffix(8), br-phone-canonical)
  telefone     String?
  telefoneSfx4 String?     @map("telefone_sfx4")
  telefoneSfx8 String?     @map("telefone_sfx8")
  /// @encrypted(global, email-lower)
  email        String?
  emailGIdx    String?     @map("email_gidx")
  /// @encrypted
  documentos   String[]
  /// @encrypted
  prefs        Json?
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  orcamentos   Orcamento[]

  @@unique([tenantId, cpfCnpjIdx])
  @@map("clientes")
}

model Orcamento {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  numero     Int
  /// @encrypted
  observacao String?
  clienteId  String  @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id])

  @@map("orcamentos")
}

model Webhook {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  url      String
  /// @encrypted
  secret   String? @map("secret_value")

  @@map("webhooks")
}
